# Names only. Never commit real credentials.
APP_ENV=development
APP_PERSISTENCE=memory

# Required when APP_PERSISTENCE=mongodb.
MONGODB_URI=
MONGODB_DB_NAME=appm_site_mapper

# One-time first-user bootstrap. Runtime secret only.
BOOTSTRAP_ADMIN_TOKEN=

# G16 telemetry runtime.
# Production is fail-closed: explicit topic settings, stable client ID and mqtts:// are required.
TELEMETRY_ENABLED=false
TELEMETRY_MAX_STREAMS=100
TELEMETRY_MAX_PAYLOAD_BYTES=262144
TELEMETRY_MAX_REPORTED_ENTRIES=512

# Service credentials for the AppManager ingestion subscriber only.
# Per-device publisher credentials are broker-managed and must never be exposed to the web app.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

# Raw hardware namespace. Source identity is the single segment between prefix and suffix.
MQTT_TOPIC_PREFIX=appmanager/v1/raw/
MQTT_TOPIC_SUFFIX=/telemetry
MQTT_TOPIC_FILTER=appmanager/v1/raw/+/telemetry
