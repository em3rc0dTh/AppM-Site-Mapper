# Names only. Never commit real credentials.
APP_ENV=development
APP_PERSISTENCE=memory

# Required when APP_PERSISTENCE=mongodb.
MONGODB_URI=
MONGODB_DB_NAME=appm_site_mapper

# One-time first-user bootstrap. Runtime secret only.
BOOTSTRAP_ADMIN_TOKEN=

# MQTT data provider. AppM consumes the provider; it does not start or clone the emulator.
TELEMETRY_ENABLED=false
TELEMETRY_MAX_STREAMS=100
TELEMETRY_MAX_PAYLOAD_BYTES=262144
# Repeated topic+reason rejection warnings are summarized at this interval.
TELEMETRY_REJECTION_LOG_INTERVAL_MS=60000
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=data/dev/
MQTT_TOPIC_FILTER=data/dev/#

# Site Mapper-owned historical telemetry store (TimescaleDB + private adapter).
TELEMETRY_HISTORY_ENABLED=false
TELEMETRY_STORE_URL=http://127.0.0.1:18081
TELEMETRY_STORE_TIMEOUT_MS=5000

# Optional mapping when MQTT source serials differ from the Device serialNumber stored in MongoDB.
# JSON object: {"EMU-BFDB-01":"<appm-device-id>"}
MQTT_SOURCE_DEVICE_MAP={}

# No automatic breaker-to-position mapping. Commission source + raw point + metric
# to the canonical Circuit Breaker Equipment ID through the authenticated API/UI.
# The declared positional panel prefix proposes a point but does NOT certify wiring.
#
# Site Mapper-owned historical telemetry (token required for APP_ENV=production).
TELEMETRY_STORE_TOKEN=
#
# Optional private Site Mapper-owned Modbus output.
# Use only approved Unit IDs for publisher serials. Set in an ignored local env.
MODBUS_SOURCE_UNITS_JSON=
MODBUS_BRIDGE_URL=
MODBUS_BRIDGE_TOKEN=
# 4x24 for the current emulator laboratory; standalone sidecar legacy default: 2x48.
MODBUS_POINT_LAYOUT=panels-4x24

# Optional diagnostics expectations (three serials for the current emulator lab).
MQTT_EXPECTED_SOURCES=

# Optional industrial integration; keep JSON credentials only in ignored environment files.
INDUSTRIAL_PROFILES_JSON=
INDUSTRIAL_INGEST_SOURCES_JSON=
INDUSTRIAL_PROJECTION_TOKEN=
INDUSTRIAL_RETENTION_DAYS=90
SNMP_TRAP_SOURCES_JSON=
SNMP_TRAP_ENGINE_ID=
MODBUS_POINTS_LOCAL_PATH=
INDUSTRIAL_MQTT_SPOOL=
# Industrial closure: read-only approved manifest shared with the Modbus bridge.
INDUSTRIAL_MODBUS_POINTS_FILE=
INDUSTRIAL_SNMP_DIAGNOSTICS_FILE=
INDUSTRIAL_MQTT_MAX_PENDING=1000
SNMP_TRAP_MAX_PENDING=1000

# Optional versioned transport aliases; same operational point survives LAB/FIELD substitution.
INDUSTRIAL_LOGICAL_POINTS_FILE=
# Durable Mongo outbox -> additive Timescale industrial series (separate from legacy samples).
INDUSTRIAL_TIMESCALE_ENABLED=false
