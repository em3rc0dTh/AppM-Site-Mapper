# Synthetic telemetry only. Do not place production credentials in this file.
#
# Copy to .env.telemetry-simulator for local use.

SIM_MQTT_BROKER_URL=mqtt://127.0.0.1:1883
SIM_MQTT_USERNAME=
SIM_MQTT_PASSWORD=
SIM_MQTT_CLIENT_ID=

# "appmanager" feeds the current G16 ingestor immediately.
# "legacy" emits the historical hardware topic exactly: data/dev/<sn>.
SIM_TOPIC_MODE=appmanager
SIM_TOPIC_SOURCE=demo-qdf-01
SIM_SERIAL_NUMBER=DEMO25110703400009

# Required only by npm run telemetry:sim:provision.
# Point this at an existing Device/Equipment in Site Mapper.
SIM_ENTITY_ID=
SIM_ENTITY_KIND=EQUIPMENT

SIM_INTERVAL_MS=10000
SIM_FRAGMENT_DELAY_MS=150
SIM_START_MSGID=597
SIM_SEED=251107
SIM_CYCLES=100

# Optional TLS settings for mqtts://.
SIM_MQTT_CA_FILE=
SIM_MQTT_INSECURE_TLS=false
