# OFFICE / FIELD test profile.
# Copy to .runtime/office-test.env and replace every CHANGE_ME value.
# .runtime/ is already ignored by Git.

APP_ENV=development
APP_PERSISTENCE=mongodb
MONGODB_DB_NAME=seed-01
SITE_MAPPER_SEED_PROFILE=seed-01
SITE_MAPPER_INTEGRATION_PROFILE=office-field

TELEMETRY_ENABLED=true
TELEMETRY_HISTORY_ENABLED=true

TIMESCALE_DB_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME
TELEMETRY_STORE_TOKEN=CHANGE_ME
MODBUS_BRIDGE_TOKEN=CHANGE_ME
SNMP_INGEST_TOKEN=CHANGE_ME
SITE_MAPPER_CREDENTIAL_KEY=CHANGE_ME

MQTT_CLIENT_ID=site-mapper-office-field
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=site-mapper-office
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC_PREFIX=office/dev/
MQTT_TOPIC_FILTER=office/dev/#
MQTT_LAN_BIND_HOST=0.0.0.0
MQTT_LAN_PORT=1883

MODBUS_SOURCE_UNITS_JSON={"26092403950003":1,"26092403950004":2,"26092403950002":3}
MODBUS_POINT_LAYOUT=blocks-2x48
MODBUS_MISSING_POLICY=zero
# Real QDF measurement bursts are approximately 5 minutes apart; keep a bounded margin.
MODBUS_STALE_MS=360000
# Metasys client-facing Modbus TCP endpoint from the approved Excel contract.
# Bind to the authorized OT/LAN interface in production; 0.0.0.0 requires firewall/ACL restriction.
MODBUS_CLIENT_BIND_HOST=0.0.0.0
MODBUS_CLIENT_PORT=502

# Synthetic SNMP used with --profile snmp-sim.
SNMP_SIM_COMMUNITY=site-mapper-office-sim
SNMP_POLL_INTERVAL_MS=5000

# Three-source Config2 SNMP profile used by OFFICE/FIELD --profile snmp.
# The 2026-11-04 lab uses v2c against host UDP 11611/11612/11613.
# Never commit the real community/auth credentials.
SNMP_REAL_VERSION=2c
SNMP_REAL_COMMUNITY=CHANGE_ME
SNMP_REAL_V2C_ACKNOWLEDGE_PLAINTEXT=true
SNMP_REAL_V3_USERNAME=
SNMP_REAL_V3_AUTH_KEY=
SNMP_REAL_V3_PRIV_KEY=

SNMP_QDF2_HOST=host.docker.internal
SNMP_QDF2_PORT=11611
SNMP_QDF2_ID=EMU-DELTA-BFDB-01

SNMP_QDF4_HOST=host.docker.internal
SNMP_QDF4_PORT=11612
SNMP_QDF4_ID=EMU-DELTA-BFDB-02

SNMP_QDF5_HOST=host.docker.internal
SNMP_QDF5_PORT=11613
SNMP_QDF5_ID=EMU-DELTA-BFDB-03
