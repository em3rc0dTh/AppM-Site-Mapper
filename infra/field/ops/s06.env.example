# Private operator configuration for /etc/site-mapper/s06.env (mode 0600).
# This is a public TEMPLATE, never paste real tokens or encryption private keys.
# Paths are examples and must be reconciled against the chosen target host.
S06_REPO_ROOT=/opt/site-mapper
S06_RUNTIME_ENV=/opt/site-mapper/.runtime/office-test.env
S06_COMPOSE_PROJECT=appm-site-mapper
S06_HOSTNAME=sitemapper.thradex.home.arpa
S06_CA_CERT=/etc/site-mapper/ca-root.crt
S06_WATCHDOG_STATE=/var/lib/site-mapper/watchdog.json
# Recovery is off by default; enable only after approved fault-injection tests.
S06_WATCHDOG_RECOVERY_ENABLED=0
# Recipient is a PUBLIC age recipient, NOT the private identity.
S06_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_RECIPIENT
S06_BACKUP_DEST=/var/backups/site-mapper
# Requires backup destination to be an independently mounted off-host volume by default.
S06_BACKUP_MOUNT_REQUIRED=1
