# Private operator configuration. Do not commit credentials or private keys.
S06_REPO_ROOT=/opt/site-mapper
S06_RUNTIME_ENV=/opt/site-mapper/.runtime/office-test.env
S06_COMPOSE_PROJECT=appm-site-mapper
S06_HOSTNAME=sitemapper.thradex.home.arpa
S06_EXPECTED_IP=192.168.10.1
S06_DNS_ZONE=thradex.home.arpa
S06_BRIDGE=br-lab
# Stage Kea DNS advertisement only by default. Set 1 only in an approved FIELD window while Kea is inactive.
S06_KEA_PUBLISH=0
# Empty means use the operating system trust store.
S06_CA_CERT=
S06_CADDY_MODE=systemd
S06_CADDY_SYSTEMD_UNIT=caddy.service
S06_DNS_SYSTEMD_UNIT=site-mapper-dns.service
S06_WATCHDOG_STATE=/var/lib/site-mapper/watchdog.json
# Recovery remains opt-in in the template. install-host-resilience.sh enables it
# only after DNS, HTTPS, Docker and the current Site Mapper container pass acceptance.
S06_WATCHDOG_RECOVERY_ENABLED=0
# Recipient is a PUBLIC age recipient, NOT the private identity.
S06_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_RECIPIENT
S06_BACKUP_DEST=/var/backups/site-mapper
S06_BACKUP_MOUNT_REQUIRED=1