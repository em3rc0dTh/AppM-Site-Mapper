[Unit]
Description=Site Mapper S06 encrypted consistent backup
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/site-mapper/s06.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/site-mapper/s06.env
WorkingDirectory=/opt/site-mapper
ExecStart=/usr/bin/python3 /opt/site-mapper/infra/field/ops/backup.py
NoNewPrivileges=true
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
