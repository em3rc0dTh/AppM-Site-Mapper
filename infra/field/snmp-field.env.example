# EXAMPLE ONLY. Copy required values into .runtime/office-test.env.
# Never commit the real private runtime file.
#
# Source identity must be the same in all three JSON variables below.
# For the controlled lab demonstration use a dedicated source identity,
# NOT a physical Telxius/Delta source. Real customer profiles are separate.
#
# Generate source secrets locally, e.g.:
#   openssl rand -hex 32
#
# JSON samples below use a non-secret placeholder intentionally.
# Replace SOURCE_TOKEN_VALUE with an actual >=32 character secret.
#
# INDUSTRIAL_INGEST_SOURCES_JSON={"EMU-TRAP-LAB-01":"SOURCE_TOKEN_VALUE"}
# INDUSTRIAL_PROFILES_JSON=[{"sourceIdentity":"EMU-TRAP-LAB-01","protocol":"SNMP","version":"lab-raw-v1","staleMs":30000,"rules":[]}]
# SNMP_TRAP_SOURCES_JSON=[{"sourceIdentity":"EMU-TRAP-LAB-01","address":"AUTHORIZED_SENDER_IPV4","version":"2c","community":"PRIVATE_TRAP_COMMUNITY","token":"SOURCE_TOKEN_VALUE"}]
#
# APP_ENV=development                     # Isolated field lab ONLY
# SNMP_TRAP_HOST_BIND=127.0.0.1           # Explicit trusted LAN IP only if needed
# SNMP_TRAP_HOST_PORT=1162
# SNMP_TRAP_MAX_PENDING=1000
# INDUSTRIAL_INGEST_URL=http://site-mapper:3000/api/telemetry/industrial/ingest
#
# For production APP_ENV=production, receiver requires HTTPS for
# INDUSTRIAL_INGEST_URL and SNMPv3 authPriv is recommended.
# Do not copy integration.yml's fixed example tokens to any deployment.
