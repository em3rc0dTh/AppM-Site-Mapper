# Deterministic NON-PRODUCTION values for the self-contained controlled integration profile.
# Never reuse any value from this file in FIELD or PRODUCTION.
APP_ENV=development
APP_PERSISTENCE=mongodb
MONGODB_DB_NAME=seed-01
SITE_MAPPER_SEED_PROFILE=seed-01
SITE_MAPPER_INTEGRATION_PROFILE=seed-01-controlled

TIMESCALE_DB_PASSWORD=seed01-integration-timescale-only
BOOTSTRAP_ADMIN_TOKEN=seed01-integration-bootstrap-token-0000000000000001
TELEMETRY_STORE_TOKEN=seed01-integration-history-token-0000000000000000001
MODBUS_BRIDGE_TOKEN=seed01-integration-modbus-token-00000000000000000001
SNMP_INGEST_TOKEN=seed01-integration-snmp-token-000000000000000000000001

TELEMETRY_ENABLED=true
TELEMETRY_HISTORY_ENABLED=true
MQTT_CLIENT_ID=site-mapper-seed01-integration
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX=data/dev/
MQTT_TOPIC_FILTER=data/dev/#

MODBUS_SOURCE_UNITS_JSON={"26092403950003":1,"26092403950004":2,"26092403950002":3}
MODBUS_POINT_LAYOUT=panels-4x24
MODBUS_MISSING_POLICY=zero
